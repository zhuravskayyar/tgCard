{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "installCommand": "npm ci",
  "buildCommand": "npm run check:i18n && npm run build --workspace shared && npm run build --workspace game-core && npm run build --workspace server && npm run build --workspace client",
  "outputDirectory": "client/dist",
  "redirects": [
    { "source": "/about.html", "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/:section(admin|api|arena|battle-pass|campaign|cards|collections|deck|duel|dungeon|equipment|forge|guild|inventory|leagues|mail|players|profile|settings|shop|tasks|trials)/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__cardastika_api_path=:path*"
    },
    { "source": "/:screen(arena|battle-pass|campaign|collections|deck|duel|dungeon|equipment|forge|guild|inventory|leagues|mail|profile|settings|shop|tasks|trials)", "destination": "/index.html" },
    { "source": "/cards/:cardId", "destination": "/index.html" },
    { "source": "/collections/:collectionId", "destination": "/index.html" },
    { "source": "/collections/:collectionId/cards/:cardId", "destination": "/index.html" },
    { "source": "/campaign/stages/:stageId", "destination": "/index.html" },
    { "source": "/campaign/boss", "destination": "/index.html" },
    { "source": "/players/:playerId", "destination": "/index.html" },
    { "source": "/trials/save", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
