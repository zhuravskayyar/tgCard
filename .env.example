# Server/runtime variables. For Vercel, use the pooled Neon connection string.
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
CLIENT_ORIGIN=https://app.cardastika.org
TELEGRAM_BOT_USERNAME=
GOOGLE_CLIENT_ID=

# Optional public build-time fallbacks. Same-origin Vercel deployment does not
# need VITE_API_URL; leave it empty so browser requests use /api on this domain.
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_TELEGRAM_BOT_USERNAME=

# Local-only tunnel settings used by npm run dev:telegram.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_NAME=
